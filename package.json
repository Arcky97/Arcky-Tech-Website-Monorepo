{
  "name": "arcky-tech-website-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev-web": "npm run dev -w web",
    "dev-docs": "npm run dev -w docs",
    "dev-dashboard": "npm run dev -w dashboard",
    "dev-pbseditor": "npm run dev -w pbseditor",
    "dev-scoreboard": "npm run dev -w scroeboard",
    "build-web": "npm run build -w web",
    "build-docs": "npm run build -w docs",
    "build-dashboard": "npm run build -w dashboard",
    "build-pbseditor": "npm run build -w pbseditor",
    "build-scoreboard": "npm run build -w scoreboard",
    "start-web": "npm run start -w web",
    "start-docs": "npm run start -w docs",
    "start-dashboard": "npm run start -w dashboard",
    "start-pbseditor": "npm run start -w pbseditor",
    "start-scoreboard": "npm run start -w scoreboard",
    "lint-web": "npm run lint -w web",
    "lint-docs": "npm run lint -w docs",
    "lint-dashboard": "npm run lint -w dashboard",
    "lint-pbseditor": "npm run lint -w pbseditor",
    "lint-scoreboard": "npm run lint -w scoreboard",
    "lint:all": "npm run lint -w web && npm run lint -w docs && npm run lint -w dashboard && npm run lint -w pbseditor && npm run lint -w scoreboard"
  }
}